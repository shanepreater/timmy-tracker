# Copy to .env.local and fill in real values for local development.
# Never commit .env.local — it's covered by .gitignore.
#
# Exception: DATABASE_URL. The Prisma CLI (migrate/studio/etc.) only
# reads `.env`, not `.env.local`, so put DATABASE_URL in a `.env` file
# instead (also gitignored) — Next.js reads both at runtime either way.

# Postgres connection string (local Postgres, or Vercel Postgres/Neon).
DATABASE_URL="postgresql://user:password@localhost:5432/timmy_tracker"

# Google Maps JavaScript API key. Required for the map feature; the site
# falls back to a placeholder if this is unset.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Auth.js — Google OAuth app credentials for the admin area.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_SECRET=""

# Feature flags — every new feature defaults to off until promoted.
# See docs/design.md#feature-flags.
NEXT_PUBLIC_FEATURE_MAP="false"
NEXT_PUBLIC_FEATURE_SUBMIT_PEBBLE="false"
FEATURE_ADMIN="false"
