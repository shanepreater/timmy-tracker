# Copy to .env.local and fill in real values for local development.
# Never commit .env.local — it's covered by .gitignore.
#
# Exception: DATABASE_URL. The Prisma CLI (migrate/studio/etc.) only
# reads `.env`, not `.env.local`, so put DATABASE_URL in a `.env` file
# instead (also gitignored) — Next.js reads both at runtime either way.

# Postgres connection string (local Postgres, or Vercel Postgres/Neon).
DATABASE_URL="postgresql://user:password@localhost:5432/timmy_tracker"

# Google Maps JavaScript API key. Required for the map feature; the site
# falls back to a placeholder if this is unset.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Map ID (Google Cloud Console > Google Maps Platform > Map Management).
# Required for pebble markers to render — AdvancedMarkerElement (the
# non-deprecated marker API) only works on a map with a Map ID. The site
# falls back to a placeholder if this is unset, same as the API key.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# Auth.js — Google OAuth app credentials for sign-in.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_SECRET=""

# Vercel Blob read/write token (used by server actions for pebble photo
# upload and deletion). Leave blank unless working on photo support.
BLOB_READ_WRITE_TOKEN=""

# Feature flags — every new feature defaults to off until promoted.
# See docs/design.md#feature-flags.
#
# map / submitPebble / pebblePhotos are NOT env vars — they moved to
# DB-backed AppSetting rows (docs/design.md's "Dynamic feature flags"
# amendment), toggleable at runtime from /admin's Settings tab instead
# of here. A fresh local Postgres has no rows for them until you either
# run `npm run db:seed` (seeds all three "true") or flip them on
# yourself in the Settings tab.
FEATURE_ADMIN="false"
# Whole-app login + whitelist gate — see docs/design-access-control.md.
# Stays an env var: read synchronously on the Edge runtime (proxy.ts),
# which has no Prisma/Postgres access, so it can't move to the DB.
FEATURE_AUTH_GATE="false"
# Strict-Transport-Security/CSP/X-Frame-Options/etc. on every response —
# see docs/features.md's "Security headers" entry. Stays an env var: read
# by next.config.ts's headers(), which loads outside the app's Prisma/DB
# access at Next's build/start time.
FEATURE_SECURITY_HEADERS="false"
