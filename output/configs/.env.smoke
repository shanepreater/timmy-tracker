# Non-secret config for local smoke-testing the base app (no external
# services required). Copy to .env.local at the repo root:
#
#   cp output/configs/.env.smoke .env.local
#   npm run dev
#
# All feature flags stay off here, matching the deployed default, so this
# only verifies the base framework renders — not any flagged feature.

DATABASE_URL="postgresql://user:password@localhost:5432/timmy_tracker"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_SECRET="smoke-test-secret"
NEXT_PUBLIC_FEATURE_MAP="false"
NEXT_PUBLIC_FEATURE_SUBMIT_PEBBLE="false"
FEATURE_ADMIN="false"
