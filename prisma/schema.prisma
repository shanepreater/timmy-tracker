generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PebbleStatus {
  PENDING
  VERIFIED
}

model Pebble {
  id               String                  @id @default(cuid())
  latitude         Float
  longitude        Float
  depositedBy      String
  photoUrl         String?
  submitterEmail   String?
  depositedAt      DateTime
  status           PebbleStatus            @default(PENDING)
  createdAt        DateTime                @default(now())
  verifiedAt       DateTime?
  additionalPhotos PebbleAdditionalPhoto[]
}

/**
 * Extra photos beyond Pebble.photoUrl (the "primary" photo, unchanged).
 * Deliberately additive rather than a photoUrl migration — see
 * docs/design-pebble-photos.md's "Multiple photos per pebble" amendment.
 * position is an explicit ordering column rather than inferred from
 * createdAt: rows created together in one batch (nested write or
 * createMany) can share an identical createdAt, since Postgres's now()
 * is transaction-start time, not statement time.
 */
model PebbleAdditionalPhoto {
  id        String   @id @default(cuid())
  pebbleId  String
  pebble    Pebble   @relation(fields: [pebbleId], references: [id], onDelete: Cascade)
  url       String
  position  Int
  createdAt DateTime @default(now())

  @@index([pebbleId])
}

model AllowedUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
}

model AccessRequest {
  id              String              @id @default(cuid())
  email           String
  name            String?
  status          AccessRequestStatus @default(PENDING)
  requestedAt     DateTime            @default(now())
  resolvedAt      DateTime?
  resolvedByEmail String?
  note            String?
}

/**
 * Generic admin-adjustable key/value config, e.g.
 * "orphanPhotoMinAgeMinutes" (see src/lib/pebble-photo-orphans.ts) —
 * not a dedicated column/table per setting, since these are simple
 * scalars an admin tweaks occasionally, not structured/queried data.
 */
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
