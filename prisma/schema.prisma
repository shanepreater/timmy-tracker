generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PebbleStatus {
  PENDING
  VERIFIED
}

model Pebble {
  id          String       @id @default(cuid())
  latitude    Float
  longitude   Float
  depositedBy String
  depositedAt DateTime
  status      PebbleStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  verifiedAt  DateTime?
}
